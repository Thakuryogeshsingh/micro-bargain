# Copy to .env and fill in real values. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=micro_bargain
POSTGRES_USER=micro_bargain
POSTGRES_PASSWORD=micro_bargain
# Use "db" inside docker-compose, "localhost" when running Django directly
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=180
OTP_EXPIRY_SECONDS=300
# console = OTP printed in the server log (development only)
SMS_BACKEND=console
# For SMS_BACKEND=msg91 (needs DLT-approved OTP template)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MAX_SHOPS_PER_MERCHANT=1

# Windows without Docker only (OSGeo4W install), e.g.
# GDAL_LIBRARY_PATH=C:/OSGeo4W/bin/gdal309.dll
# GEOS_LIBRARY_PATH=C:/OSGeo4W/bin/geos_c.dll

CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SENTRY_DSN=

# console = log pushes; fcm = send via Firebase (needs the service-account JSON path below)
PUSH_BACKEND=console
FCM_CREDENTIALS_FILE=
# fake = no real money (development); razorpay = live/test Razorpay keys below
PAYMENT_BACKEND=fake
# Grievance contact on /legal/privacy/ and /legal/terms/
SUPPORT_EMAIL=support@microbargain.in
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
